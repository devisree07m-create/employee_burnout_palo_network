():\n","        return 0.5\n","    return (series - series.min()) / (series.max() - series.min())\n","\n","# A. Engagement Index (Scale 0 to 10)\n","# Built from: JobInvolvement (1-4), PerformanceRating (1-4), StockOptionLevel (0-3)\n","df['Engagement_Index'] = (\n","    min_max_scale(df['JobInvolvement']) * 4 +\n","    min_max_scale(df['PerformanceRating']) * 3 +\n","    min_max_scale(df['StockOptionLevel']) * 3\n",") * 1.0\n","\n","# B. Burnout Risk (Scale 0 to 10)\n","# Built from: OverTime (0 or 1), DistanceFromHome (long distance adds risk), and low WorkLifeBalance\n","df['Burnout_Risk'] = (\n","    df['OverTime_Numeric'] * 4 +\n","    min_max_scale(df['DistanceFromHome']) * 3 +\n","    (1 - min_max_scale(df['WorkLifeBalance'])) * 3\n",")\n","\n","# C. Work-Life Balance Rating (Scale 0 to 10)\n","# Based on original WorkLifeBalance score adjusted negatively by Travel Frequency\n","travel_impact = df['BusinessTravel'].map({'Non-Travel': 1.0, 'Travel_Rarely': 0.85, 'Travel_Frequently': 0.6})\n","df['Work_Life_Balance_Adjusted'] = (\n","    min_max_scale(df['WorkLifeBalance']) * 8 +\n","    travel_impact * 2\n",")\n","\n","# D. Satisfaction Stability (Scale 0 to 10)\n","# Standard deviation (or consistency) and mean of Environment, Job, and Relationship satisfaction\n","sat_cols = ['EnvironmentSatisfaction', 'JobSatisfaction', 'RelationshipSatisfaction']\n","df['Satisfaction_Stability'] = df[sat_cols].mean(axis=1) * 2.5\n","\n","# E. Workload / Stress Score (Scale 0 to 10)\n","# Driven by Overtime, NumCompaniesWorked, and low Satisfaction scores\n","df['Workload_Stress_Score'] = (\n","    df['OverTime_Numeric'] * 5 +\n","    min_max_scale(df['NumCompaniesWorked']) * 2 +\n","    (1 - min_max_scale(df['EnvironmentSatisfaction'])) * 3\n",")\n","\n","# Display preview of engineered features\n","display(df[['Engagement_Index', 'Burnout_Risk', 'Work_Life_Balance_Adjusted', 'Satisfaction_Stability', 'Workload_Stress_Score']].head())"],"execution_count":1,"outputs":[{"out